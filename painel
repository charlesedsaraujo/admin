        function getEscopoTexto(promo) {
            switch(promo.escopoDado) {
                case 'categoria': return `Categoria: ${getCategoriaNome(promo.categoriaId)}`;
                case 'produto': return `Produto: ${getProdutoNome(promo.produtoId)}`;
                case 'combo': return 'Combo';
                case 'pedido_minimo': return `Pedido acima de R$ ${promo.valor}`;
                default: return 'Não definido';
            }
        }

        function getCategoriaNome(categoriaId) {
            const categoria = cardapioData.categorias.find(c => c.id === categoriaId);
            return categoria ? categoria.nome : 'N/A';
        }

        function getProdutoNome(produtoId) {
            const produto = cardapioData.produtos.find(p => p.id === produtoId);
            return produto ? produto.nome : 'N/A';
        }

        function calcularDescontoTextoPromocao(promo) {
            switch(promo.tipoDesconto) {
                case 'percentual':
                    return `${promo.valor}% OFF`;
                case 'valor_fixo':
                    return `R$ ${promo.valor.toFixed(2)} OFF`;
                case 'preco_fixo':
                    return `R$ ${promo.valor.toFixed(2)}`;
                case 'compre_leve':
                    return `Compre X, Leve Y`;
                default:
                    return 'Desconto';
            }
        }

        function formatarRestricoesPromocao(promo) {
            const restricoes = promo.restricoes;
            const partes = [];
            
            if (restricoes.diasSemana && restricoes.diasSemana.length > 0 && restricoes.diasSemana.length < 7) {
                const diasNomes = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'];
                const diasTexto = restricoes.diasSemana.map(d => diasNomes[d]).join(', ');
                partes.push(`Válido: ${diasTexto}`);
            }
            
            if (restricoes.horarioInicio && restricoes.horarioFim) {
                partes.push(`${restricoes.horarioInicio} - ${restricoes.horarioFim}`);
            } else if (restricoes.horarioInicio) {
                partes.push(`A partir de ${restricoes.horarioInicio}`);
            } else if (restricoes.horarioFim) {
                partes.push(`Até ${restricoes.horarioFim}`);
            }

            if (restricoes.quantidadeMinima && restricoes.quantidadeMinima > 0) {
                partes.push(`Mínimo: ${restricoes.quantidadeMinima} item(s)`);
            }
            
            return partes.join(' • ');
        }

