        function calcularDescontoTexto(combo) {
            switch(combo.tipoDesconto) {
                case 'percentual':
                    return `${combo.valorDesconto}% OFF`;
                case 'valor_fixo':
                    return `R$ ${combo.valorDesconto.toFixed(2)} OFF`;
                case 'preco_fixo':
                    return `Preço fixo`;
                case 'segundo_desconto':
                    return `${combo.valorDesconto}% no 2º item`;
                case 'item_gratis':
                    return `${combo.itemGratisNome} grátis`;
                default:
                    return 'Desconto';
            }
        }

        function formatarRestricoesCombo(combo) {
            const restricoes = combo.restricoes;
            const partes = [];
            
            if (restricoes.diasSemana && restricoes.diasSemana.length > 0 && restricoes.diasSemana.length < 7) {
                const diasNomes = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'];
                const diasTexto = restricoes.diasSemana.map(d => diasNomes[d]).join(', ');
                partes.push(`Válido: ${diasTexto}`);
            }
            
            if (restricoes.horarioInicio && restricoes.horarioFim) {
                partes.push(`${restricoes.horarioInicio} - ${restricoes.horarioFim}`);
            } else if (restricoes.horarioInicio) {
                partes.push(`A partir de ${restricoes.horarioInicio}`);
            } else if (restricoes.horarioFim) {
                partes.push(`Até ${restricoes.horarioFim}`);
            }
            
            return partes.join(' • ');
        }

