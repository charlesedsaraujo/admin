        // Detectar quando modais estão abertos
        function detectarModaisAbertos() {
            const observer = new MutationObserver(() => {
                const modaisAbertos = document.querySelectorAll('.fixed.inset-0.bg-black.bg-opacity-50.z-50');
                const statusButton = document.getElementById('status-button');
                
                if (modaisAbertos.length > 0) {
                    statusButton.classList.add('hidden-by-modal');
                } else {
                    statusButton.classList.remove('hidden-by-modal');
                }
            });
            
            observer.observe(document.body, {
                childList: true,
                subtree: true
            });
        }

