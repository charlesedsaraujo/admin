                    if (confirm('Tem certeza que deseja cancelar? As alterações não salvas serão perdidas.')) {
                        resetarFormularioPerfil();
                    }
                });
            }
        }

        function toggleDiaFuncionamento(checkbox) {
            const diaBloco = checkbox.closest('[data-dia]');
            if (!diaBloco) return;
            
            const isChecked = checkbox.checked;
            const inputs = diaBloco.querySelectorAll('input[type="time"]');
            const botaoAdicionar = diaBloco.querySelector('button[onclick*="adicionarTurno"]');
            
            // Habilitar/desabilitar inputs
            inputs.forEach(input => {
                input.disabled = !isChecked;
            });
            
            // Habilitar/desabilitar botão de adicionar
            if (botaoAdicionar) {
                botaoAdicionar.disabled = !isChecked;
                if (!isChecked) {
                    botaoAdicionar.classList.add('opacity-50', 'cursor-not-allowed');
                } else {
                    botaoAdicionar.classList.remove('opacity-50', 'cursor-not-allowed');
                }
            }
            
            // Atualizar visual do dia
            if (isChecked) {
                diaBloco.classList.remove('opacity-60');
            } else {
                diaBloco.classList.add('opacity-60');
            }
        }

        function adicionarTurno(button) {
            const diaBloco = button.closest('[data-dia]');
            if (!diaBloco) return;
            
            const turnosList = diaBloco.querySelector('.turnos-list');
            if (!turnosList) return;
            
            const totalTurnos = turnosList.querySelectorAll('.turno-item').length;
            
            if (totalTurnos >= 3) {
                alert('Máximo de 3 turnos por dia permitido.');
                return;
            }
            
            const checkbox = diaBloco.querySelector('.dia-checkbox');
            const novoTurno = document.createElement('div');
            novoTurno.className = 'turno-item flex items-center space-x-2';
            novoTurno.innerHTML = `
                <input type="time" value="08:00" class="horario-inicio px-2 py-1 border border-gray-200 rounded text-sm focus:ring-1 focus:ring-orange-500 focus:border-orange-500 flex-1" ${!checkbox.checked ? 'disabled' : ''}>
                <span class="text-gray-400 text-sm">às</span>
                <input type="time" value="12:00" class="horario-fim px-2 py-1 border border-gray-200 rounded text-sm focus:ring-1 focus:ring-orange-500 focus:border-orange-500 flex-1" ${!checkbox.checked ? 'disabled' : ''}>
                <button type="button" onclick="removerTurno(this)" class="text-red-600 hover:text-red-800 text-xs font-medium" title="Remover turno">
                    <i class="fas fa-trash text-xs"></i>
                </button>
            `;
            
            turnosList.appendChild(novoTurno);
        }

        function removerTurno(button) {
            const turnoItem = button.closest('.turno-item');
            if (!turnoItem) return;
            
            const turnosList = turnoItem.closest('.turnos-list');
            if (!turnosList) return;
            
            const totalTurnos = turnosList.querySelectorAll('.turno-item').length;
            
            if (totalTurnos > 1) {
                turnoItem.remove();
            } else {
                alert('É obrigatório ter pelo menos um turno por dia.');
            }
        }

