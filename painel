        function fecharModalDesconto() {
            if (window.modalDescontoAberto) {
                const { overlay, modal } = window.modalDescontoAberto;
                
                modal.classList.remove('translate-y-0', 'opacity-100');
                modal.classList.add('translate-y-full', 'opacity-0');
                
                setTimeout(() => {
                    if (overlay && overlay.parentNode) {
                        overlay.remove();
                    }
                    window.modalDescontoAberto = null;
                }, 300);
            }
        }

