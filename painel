        function atualizarPreviewCombo() {
            const itens = Array.from(document.querySelectorAll('#lista-itens-combo [data-item-index]')).map(div => {
                const select = div.querySelector('.item-produto');
                const quantidade = parseInt(div.querySelector('.item-quantidade').value) || 0;
                const option = select.options[select.selectedIndex];
                
                return {
                    produtoId: parseInt(select.value),
                    quantidade: quantidade,
                    preco: parseFloat(option.dataset.preco),
                    nome: option.dataset.nome
                };
            });
            
            const precoOriginal = itens.reduce((total, item) => total + (item.preco * item.quantidade), 0);
            
            const tipoDesconto = document.getElementById('tipo-desconto-combo').value;
            let precoFinal = precoOriginal;
            let descontoValor = 0;
            
            switch(tipoDesconto) {
                case 'percentual':
                    const percentual = parseFloat(document.getElementById('valor-desconto-combo')?.value) || 0;
                    descontoValor = precoOriginal * (percentual / 100);
                    precoFinal = precoOriginal - descontoValor;
                    break;
                    
                case 'valor_fixo':
                    descontoValor = parseFloat(document.getElementById('valor-desconto-combo')?.value) || 0;
                    precoFinal = Math.max(0, precoOriginal - descontoValor);
                    break;
                    
                case 'preco_fixo':
                    precoFinal = parseFloat(document.getElementById('preco-fixo-combo')?.value) || 0;
                    descontoValor = Math.max(0, precoOriginal - precoFinal);
                    break;
                    
                case 'segundo_desconto':
                    if (itens.length >= 2) {
                        const itemMenorValor = itens.reduce((menor, item) => {
                            const valorItem = item.preco * item.quantidade;
                            const valorMenor = menor.preco * menor.quantidade;
                            return valorItem < valorMenor ? item : menor;
                        });
                        const percentualSegundo = parseFloat(document.getElementById('valor-desconto-combo')?.value) || 0;
                        descontoValor = (itemMenorValor.preco * itemMenorValor.quantidade) * (percentualSegundo / 100);
                        precoFinal = precoOriginal - descontoValor;
                    }
                    break;
                    
                case 'item_gratis':
                    const itemGratisSelect = document.getElementById('item-gratis-combo');
                    if (itemGratisSelect) {
                        const option = itemGratisSelect.options[itemGratisSelect.selectedIndex];
                        if (option && option.value) {
                            const itemGratisId = parseInt(option.value);
                            const itemGratis = itens.find(i => i.produtoId === itemGratisId);
                            if (itemGratis) {
                                descontoValor = itemGratis.preco * itemGratis.quantidade;
                                precoFinal = precoOriginal - descontoValor;
                            }
                        }
                    }
                    break;
            }
            
            document.getElementById('preco-original-preview').textContent = `R$ ${precoOriginal.toFixed(2)}`;
            document.getElementById('desconto-preview').textContent = `- R$ ${descontoValor.toFixed(2)}`;
            document.getElementById('preco-final-preview').textContent = `R$ ${precoFinal.toFixed(2)}`;
        }

        function salvarCombo() {
            const nome = document.getElementById('nome-combo').value.trim();
            const descricao = document.getElementById('descricao-combo').value.trim();
            
            // Coletar itens
            const itens = Array.from(document.querySelectorAll('#lista-itens-combo [data-item-index]')).map(div => {
                const select = div.querySelector('.item-produto');
                const quantidade = parseInt(div.querySelector('.item-quantidade').value);
                const option = select.options[select.selectedIndex];
                
                return {
                    produtoId: parseInt(select.value),
                    quantidade: quantidade,
                    nome: option.dataset.nome
                };
            });
            
            if (itens.length === 0) {
                alert('Adicione pelo menos um item ao combo.');
                return;
            }
            
            // Calcular preços
            const precoOriginal = itens.reduce((total, item) => {
                const produto = cardapioData.produtos.find(p => p.id === item.produtoId);
                return total + (produto.preco * item.quantidade);
            }, 0);
            
            const tipoDesconto = document.getElementById('tipo-desconto-combo').value;
            let valorDesconto = 0;
            let precoFinal = precoOriginal;
            let precoFixo = null;
            let itemGratisId = null;
            let itemGratisNome = null;
            
            switch(tipoDesconto) {
                case 'percentual':
                case 'segundo_desconto':
                    valorDesconto = parseFloat(document.getElementById('valor-desconto-combo').value);
                    break;
                    
                case 'valor_fixo':
                    valorDesconto = parseFloat(document.getElementById('valor-desconto-combo').value);
                    break;
                    
                case 'preco_fixo':
                    precoFixo = parseFloat(document.getElementById('preco-fixo-combo').value);
                    break;
                    
                case 'item_gratis':
                    const itemGratisSelect = document.getElementById('item-gratis-combo');
                    const option = itemGratisSelect.options[itemGratisSelect.selectedIndex];
                    itemGratisId = parseInt(option.value);
                    itemGratisNome = option.dataset.nome;
                    break;
            }
            
            // Calcular preço final
            switch(tipoDesconto) {
                case 'percentual':
                    precoFinal = precoOriginal * (1 - valorDesconto / 100);
                    break;
                    
                case 'valor_fixo':
                    precoFinal = precoOriginal - valorDesconto;
                    break;
                    
                case 'preco_fixo':
                    precoFinal = precoFixo;
                    break;
                    
                case 'segundo_desconto':
                    if (itens.length >= 2) {
                        let menorPreco = Infinity;
                        itens.forEach(item => {
                            const produto = cardapioData.produtos.find(p => p.id === item.produtoId);
                            const valorItem = produto.preco * item.quantidade;
                            if (valorItem < menorPreco) {
                                menorPreco = valorItem;
                            }
                        });
                        precoFinal = precoOriginal - (menorPreco * (valorDesconto / 100));
                    }
                    break;
                    
                case 'item_gratis':
                    const itemGratis = itens.find(i => i.produtoId === itemGratisId);
                    if (itemGratis) {
                        const produtoGratis = cardapioData.produtos.find(p => p.id === itemGratisId);
                        precoFinal = precoOriginal - (produtoGratis.preco * itemGratis.quantidade);
                    }
                    break;
            }
            
            // Coletar restrições
            const diasSemana = Array.from(document.querySelectorAll('.dia-semana-combo:checked')).map(cb => parseInt(cb.value));
            const horarioInicio = document.getElementById('horario-inicio-combo').value || null;
            const horarioFim = document.getElementById('horario-fim-combo').value || null;
            
            const isEdicao = window.modalComboAberto?.comboId !== null;
            
            const comboData = {
                nome,
                descricao,
                ativo: true,
                itens,
                precoOriginal,
                tipoDesconto,
                valorDesconto,
                precoFinal,
                precoFixo,
                itemGratisId,
                itemGratisNome,
                restricoes: {
                    diasSemana,
                    horarioInicio,
                    horarioFim
                }
            };
            
            if (isEdicao) {
                const comboId = window.modalComboAberto.comboId;
                const comboIndex = cardapioData.combos.findIndex(c => c.id === comboId);
                
                if (comboIndex !== -1) {
                    cardapioData.combos[comboIndex] = {
                        ...cardapioData.combos[comboIndex],
                        ...comboData
                    };
                }
            } else {
                const novoId = Math.max(...(cardapioData.combos.map(c => c.id) || [0]), 0) + 1;
                
                cardapioData.combos.push({
                    id: novoId,
                    ...comboData
                });
            }
            
            renderizarCardapio();
            fecharModalCombo();
        }

