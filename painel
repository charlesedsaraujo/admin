        function removerDiaFolga(diaId) {
            const dia = sistemaDados.diasFolga.find(d => d.id === diaId);
            const dataObj = new Date(dia.data);
            const dataFormatada = dataObj.toLocaleDateString('pt-BR', { year: 'numeric', month: 'long', day: 'numeric' });
            
            if (confirm(`Tem certeza que deseja remover o dia de folga em ${dataFormatada}?`)) {
                const diaIndex = sistemaDados.diasFolga.findIndex(d => d.id === diaId);
                if (diaIndex !== -1) {
