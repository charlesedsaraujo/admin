        function salvarPromocao() {
            const nome = document.getElementById('nome-desconto').value.trim();
            const descricao = document.getElementById('descricao-desconto').value.trim();
            const tipoDesconto = document.getElementById('tipo-desconto').value;
            const valor = parseFloat(document.getElementById('valor-desconto').value);
            const escopo = document.getElementById('escopo-desconto').value;

            if (!nome || !descricao || isNaN(valor) || valor <= 0) {
                alert('Preencha todos os campos obrigatórios corretamente.');
                return;
            }

            // Validar campos de escopo
            let categoriaId = null;
            let produtoId = null;

            if (escopo === 'categoria') {
                categoriaId = parseInt(document.getElementById('categoria-escopo').value);
                if (!categoriaId) {
                    alert('Selecione uma categoria.');
                    return;
                }
            } else if (escopo === 'produto') {
                produtoId = parseInt(document.getElementById('produto-escopo').value);
                if (!produtoId) {
                    alert('Selecione um produto.');
                    return;
                }
            }

            // Coletar restrições
            const diasSemana = Array.from(document.querySelectorAll('.dia-semana-desconto:checked')).map(cb => parseInt(cb.value));
            const horarioInicio = document.getElementById('horario-inicio-desconto').value || null;
            const horarioFim = document.getElementById('horario-fim-desconto').value || null;
            const quantidadeMinima = parseInt(document.getElementById('quantidade-minima-desconto').value) || null;

            const isEdicao = window.modalDescontoAberto?.descontoId !== null;

            const promocaoData = {
                nome,
                descricao,
                ativo: true,
                tipoDesconto,
                valor,
                escopoDado: escopo,
                categoriaId,
                produtoId,
                restricoes: {
                    diasSemana,
                    horarioInicio,
                    horarioFim,
                    quantidadeMinima
                }
            };

            if (isEdicao) {
                const descontoId = window.modalDescontoAberto.descontoId;
                const promocaoIndex = cardapioData.promocoes.findIndex(p => p.id === descontoId);
                
                if (promocaoIndex !== -1) {
                    cardapioData.promocoes[promocaoIndex] = {
                        ...cardapioData.promocoes[promocaoIndex],
                        ...promocaoData
                    };
                }
            } else {
                const novoId = Math.max(...(cardapioData.promocoes.map(p => p.id) || [0]), 0) + 1;
                
                cardapioData.promocoes.push({
                    id: novoId,
                    ...promocaoData
                });
            }

            renderizarListaDescontos();
            renderizarCardapio();
            fecharModalDesconto();
        }

        function editarPromocao(promocaoId) {
            abrirModalDesconto(promocaoId);
        }

        function toggleDisponibilidadePromocao(promocaoId) {
            const promocaoIndex = cardapioData.promocoes.findIndex(p => p.id === promocaoId);
            if (promocaoIndex !== -1) {
                cardapioData.promocoes[promocaoIndex].ativo = !cardapioData.promocoes[promocaoIndex].ativo;
                renderizarListaDescontos();
                renderizarCardapio();
            }
        }

        function removerPromocao(promocaoId) {
            const promocao = cardapioData.promocoes.find(p => p.id === promocaoId);
            
            if (confirm(`Tem certeza que deseja remover a promoção "${promocao.nome}"?`)) {
                const promocaoIndex = cardapioData.promocoes.findIndex(p => p.id === promocaoId);
                if (promocaoIndex !== -1) {
                    cardapioData.promocoes.splice(promocaoIndex, 1);
                    renderizarListaDescontos();
                    renderizarCardapio();
                }
            }
        }

        // Alias para compatibilidade
        function abrirModalPromocao(promocaoId = null) {
            abrirModalDesconto(promocaoId);
        }

        // Funções de Senha Operacional
        function toggleEditarSenhaOperacional() {
            const form = document.getElementById('form-senha-operacional');
            const btn = document.getElementById('btn-editar-senha');
            
            form.classList.toggle('hidden');
            
            if (!form.classList.contains('hidden')) {
                document.getElementById('input-nova-senha').focus();
            }
        }

        function cancelarEditarSenhaOperacional() {
            const form = document.getElementById('form-senha-operacional');
            form.classList.add('hidden');
            
            document.getElementById('input-nova-senha').value = '';
            document.getElementById('input-confirmar-senha').value = '';
        }

        function confirmarSenhaOperacional() {
            const novaSenha = document.getElementById('input-nova-senha').value.trim();
            const confirmarSenha = document.getElementById('input-confirmar-senha').value.trim();
            
            if (!novaSenha || novaSenha.length !== 4) {
                alert('Digite exatamente 4 dígitos na nova senha.');
                return;
            }
            
            if (!/^\d+$/.test(novaSenha)) {
                alert('A senha deve conter apenas dígitos numéricos.');
                return;
            }
            
            if (novaSenha !== confirmarSenha) {
                alert('As senhas não correspondem. Verifique e tente novamente.');
                return;
            }
            
            sistemaDados.senhaOperacional = novaSenha;
            
            document.getElementById('input-nova-senha').value = '';
            document.getElementById('input-confirmar-senha').value = '';
            document.getElementById('form-senha-operacional').classList.add('hidden');
            
            atualizarStatusSenha();
            
            alert('Senha operacional configurada com sucesso!');
        }

        function atualizarStatusSenha() {
            const status = document.getElementById('status-senha-operacional');
            const btn = document.getElementById('btn-editar-senha');
            
            if (sistemaDados.senhaOperacional) {
                status.textContent = '✓ Configurada';
                status.className = 'text-sm font-medium text-green-600';
                btn.innerHTML = '<i class="fas fa-edit mr-2"></i>Alterar Senha';
            } else {
                status.textContent = 'Não configurada';
                status.className = 'text-sm font-medium text-gray-600';
                btn.innerHTML = '<i class="fas fa-edit mr-2"></i>Configurar Senha';
            }
        }

