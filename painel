            if (!campoValor) return;

            let labelTexto = 'Valor do Desconto';
            let placeholderTexto = '0,00';

            switch(tipoDesconto) {
                case 'percentual':
                    labelTexto = 'Percentual de Desconto (%)';
                    placeholderTexto = 'Ex: 10';
                    break;
                case 'valor_fixo':
                    labelTexto = 'Valor do Desconto (R$)';
                    placeholderTexto = 'Ex: 5,00';
                    break;
                case 'preco_fixo':
                    labelTexto = 'Preço Final (R$)';
                    placeholderTexto = 'Ex: 29,90';
                    break;
                case 'compre_leve':
                    labelTexto = 'Quantidade a Comprar';
                    placeholderTexto = 'Ex: 2';
                    break;
            }

