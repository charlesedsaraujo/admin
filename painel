            const produtosDisponiveis = cardapioData.produtos.filter(p => p.disponivel);
            
            const modalHTML = `
                <div class="px-6 py-4 border-b border-gray-200 rounded-t-xl bg-gradient-to-r from-purple-50 to-pink-50">
