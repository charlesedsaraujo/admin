            let gorjetaPessoa = 0;
            if (pessoa.gorjetaHabilitada) {
                if (!pessoa.gorjetaTipo || pessoa.gorjetaTipo === 'percentual') {
                    const gorjetaPercentual = pessoa.gorjetaPercentual || 10;
                    gorjetaPessoa = subtotalRestante * (gorjetaPercentual / 100);
                } else if (pessoa.gorjetaTipo === 'fixo') {
                    gorjetaPessoa = pessoa.gorjetaValorFixo || 0;
                }
