                                    <div class="w-7 h-4 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-3 after:w-3 after:transition-all peer-checked:bg-orange-500"></div>
                                </label>
                                <span class="text-gray-600">Gorjeta</span>
                                ${pessoa.gorjetaHabilitada ? `
                                    <button onclick="editarGorjeta(${mesa.id}, ${pessoa.id})" class="ml-1.5 text-blue-600 hover:text-blue-800 text-xs" title="Editar gorjeta">
                                        Editar
                                    </button>
                                ` : ''}
                            </div>
                            <span class="text-gray-900">R$ ${gorjetaPessoa.toFixed(2)}${pessoa.gorjetaHabilitada ? (pessoa.gorjetaTipo === 'fixo' ? ' (fixo)' : (pessoa.gorjetaPercentual !== 10 ? ` (${pessoa.gorjetaPercentual}%)` : '')) : ''}</span>
                        </div>
                        <div class="flex justify-between text-xs font-semibold border-t border-gray-200 pt-1">
                            <span class="text-gray-900">Total</span>
                            <span class="text-orange-600">R$ ${totalComGorjeta.toFixed(2)}</span>
                        </div>
                    </div>

                    ${!jaQuitou ? `
                        <button onclick="mostrarFormPagamento(${mesa.id}, ${pessoa.id})" class="mt-2 text-xs text-green-600 hover:text-green-800">
                            + Registrar pagamento
                        </button>
                        
                        <!-- Formulário de Pagamento (oculto por padrão) -->
                        <div id="form-pagamento-${mesa.id}-${pessoa.id}" class="hidden mt-2 p-2 bg-gray-50 rounded-lg space-y-2">
                            <div class="bg-white p-2 rounded border border-gray-200">
                                <div class="flex justify-between text-xs mb-1">
                                    <span class="text-gray-600">Total a pagar</span>
                                    <span class="font-bold text-orange-600">R$ ${totalComGorjeta.toFixed(2)}</span>
                                </div>
                            </div>
                            <select id="select-forma-${mesa.id}-${pessoa.id}" class="w-full px-2 py-1.5 text-xs border border-gray-300 rounded focus:ring-1 focus:ring-green-500">
                                <option value="">Forma de pagamento...</option>
                                <option value="Dinheiro">Dinheiro</option>
                                <option value="Pix">Pix</option>
                                <option value="Débito">Débito</option>
                                <option value="Crédito">Crédito</option>
                            </select>
                            <input type="number" id="input-valor-${mesa.id}-${pessoa.id}" step="0.01" min="0.01" max="${totalComGorjeta.toFixed(2)}" value="${totalComGorjeta.toFixed(2)}" placeholder="Valor" class="w-full px-2 py-1.5 text-xs border border-gray-300 rounded focus:ring-1 focus:ring-green-500">
                            <div class="flex space-x-2">
                                <button onclick="confirmarPagamento(${mesa.id}, ${pessoa.id})" class="flex-1 px-2 py-1.5 bg-green-500 text-white text-xs rounded hover:bg-green-600">
                                    Confirmar
                                </button>
                                <button onclick="cancelarFormPagamento(${mesa.id}, ${pessoa.id})" class="flex-1 px-2 py-1.5 bg-gray-200 text-gray-600 text-xs rounded hover:bg-gray-300">
                                    Cancelar
                                </button>
                            </div>
                        </div>
                    ` : ''}
                </div>
            `;
        }

        function fecharModalDetalheMesa() {
            if (window.modalMesaAberto) {
                const { overlay, modal } = window.modalMesaAberto;
                
                modal.classList.remove('opacity-100', 'scale-100');
                modal.classList.add('opacity-0', 'scale-95');
                
                setTimeout(() => {
                    if (overlay && overlay.parentNode) {
                        overlay.remove();
                    }
                    window.modalMesaAberto = null;
                }, 300);
            }
        }

        function atualizarModalDetalheMesa() {
            if (window.modalMesaAberto) {
                const { mesaId, modal } = window.modalMesaAberto;
                const mesa = salaoData.mesas.find(m => m.id === mesaId);
                if (mesa) {
                    modal.innerHTML = gerarHTMLDetalheMesa(mesa);
                }
            }
        }

        // Funções de Mesa
        function abrirDetalheMesa(mesaId) {
            const mesa = salaoData.mesas.find(m => m.id === mesaId);
            if (!mesa) return;

            if (mesa.status === 'livre') {
                mostrarOpcoesOcuparReservar(mesaId);
                return;
            }

            if (mesa.status === 'reservada') {
                mostrarOpcoesReservada(mesaId);
                return;
            }

            // Mesa ocupada - abrir modal de detalhes
            abrirModalDetalheMesa(mesaId);
        }

        // Funções de Cálculo
        function calcularTotalPessoa(pessoa) {
            return pessoa.pedidos.reduce((total, pedido) => {
                return total + (pedido.quantidade * pedido.precoUnitario);
            }, 0);
        }

        function calcularTotalPagoPessoa(pessoa) {
            return pessoa.pagamentos.reduce((total, pagamento) => total + pagamento.valor, 0);
        }

        function calcularSubtotalMesa(mesa) {
            return mesa.pessoas.reduce((total, pessoa) => total + calcularTotalPessoa(pessoa), 0);
        }

        function calcularTotalPagoMesa(mesa) {
            return mesa.pessoas.reduce((total, pessoa) => total + calcularTotalPagoPessoa(pessoa), 0);
        }

        function calcularGorjetaMesa(mesa) {
            return mesa.pessoas.reduce((total, pessoa) => {
                if (pessoa.gorjetaHabilitada) {
                    // Se for tipo 'percentual', calcula baseado no percentual
                    if (!pessoa.gorjetaTipo || pessoa.gorjetaTipo === 'percentual') {
                        const totalPessoa = calcularTotalPessoa(pessoa);
                        const totalPago = calcularTotalPagoPessoa(pessoa);
                        const subtotalRestante = totalPessoa - totalPago;
                        const percentual = pessoa.gorjetaPercentual || 10;
                        return total + (subtotalRestante * (percentual / 100));
                    }
                    // Se for tipo 'fixo', usa o valor fixo
                    else if (pessoa.gorjetaTipo === 'fixo') {
                        return total + (pessoa.gorjetaValorFixo || 0);
                    }
                }
                return total;
            }, 0);
        }

        function todosJaPagaram(mesa) {
            return mesa.pessoas.every(pessoa => {
                const totalPessoa = calcularTotalPessoa(pessoa);
                const totalPago = calcularTotalPagoPessoa(pessoa);
                const subtotalRestante = totalPessoa - totalPago;
                
                let gorjetaPessoa = 0;
                if (pessoa.gorjetaHabilitada) {
                    if (!pessoa.gorjetaTipo || pessoa.gorjetaTipo === 'percentual') {
                        const percentual = pessoa.gorjetaPercentual || 10;
                        gorjetaPessoa = subtotalRestante * (percentual / 100);
                    } else if (pessoa.gorjetaTipo === 'fixo') {
                        gorjetaPessoa = pessoa.gorjetaValorFixo || 0;
                    }
                }
                
                const totalComGorjeta = subtotalRestante + gorjetaPessoa;
                return totalComGorjeta <= 0;
            });
        }

        // Funções de Ação
        function mostrarTransferenciaAtendente(mesaId) {
            const form = document.getElementById(`form-transferencia-${mesaId}`);
            const input = document.getElementById(`input-atendente-${mesaId}`);
            
            form.classList.toggle('hidden');
            if (!form.classList.contains('hidden')) {
                input.focus();
            }
        }

        function confirmarTransferenciaAtendente(mesaId) {
            const mesa = salaoData.mesas.find(m => m.id === mesaId);
            if (!mesa) return;

            const novoAtendente = document.getElementById(`input-atendente-${mesaId}`).value.trim();
            if (!novoAtendente) return;

            mesa.atendente = novoAtendente;
            atualizarModalDetalheMesa();
        }

        function cancelarTransferenciaAtendente(mesaId) {
            const form = document.getElementById(`form-transferencia-${mesaId}`);
            form.classList.add('hidden');
        }

        function mostrarFormAdicionarPessoa(mesaId) {
            const form = document.getElementById(`form-adicionar-pessoa-${mesaId}`);
            const input = document.getElementById(`input-nome-pessoa-${mesaId}`);
            
            form.classList.toggle('hidden');
            if (!form.classList.contains('hidden')) {
                input.focus();
            }
        }

        function confirmarAdicionarPessoa(mesaId) {
            const mesa = salaoData.mesas.find(m => m.id === mesaId);
            if (!mesa) return;

            const nome = document.getElementById(`input-nome-pessoa-${mesaId}`).value.trim();
            if (!nome) return;

            const novoId = Math.max(...mesa.pessoas.map(p => p.id), 0) + 1;
            
            mesa.pessoas.push({
                id: novoId,
                nome: nome,
                responsavel: false,
                pedidos: [],
                gorjetaHabilitada: true,
                pagamentos: []
            });

            document.getElementById(`input-nome-pessoa-${mesaId}`).value = '';
            atualizarModalDetalheMesa();
        }

        function cancelarAdicionarPessoa(mesaId) {
            const form = document.getElementById(`form-adicionar-pessoa-${mesaId}`);
            const input = document.getElementById(`input-nome-pessoa-${mesaId}`);
            
            form.classList.add('hidden');
            input.value = '';
        }

        function mostrarFormPedido(mesaId, pessoaId) {
            const form = document.getElementById(`form-pedido-${mesaId}-${pessoaId}`);
            form.classList.toggle('hidden');
        }

        function confirmarPedido(mesaId, pessoaId) {
            const mesa = salaoData.mesas.find(m => m.id === mesaId);
            if (!mesa) return;

            const pessoa = mesa.pessoas.find(p => p.id === pessoaId);
            if (!pessoa) return;

            const produtoId = parseInt(document.getElementById(`select-produto-${mesaId}-${pessoaId}`).value);
            const quantidade = parseInt(document.getElementById(`input-qtd-${mesaId}-${pessoaId}`).value);
            const observacoes = document.getElementById(`input-obs-${mesaId}-${pessoaId}`).value.trim();
            
            if (!produtoId || quantidade < 1) return;
            
            const produto = cardapioData.produtos.find(p => p.id === produtoId);
            if (!produto) return;
            
            const novoPedidoId = Math.max(...pessoa.pedidos.map(p => p.id), 0) + 1;
            
            pessoa.pedidos.push({
                id: novoPedidoId,
                produtoNome: produto.nome,
                quantidade: quantidade,
                precoUnitario: produto.preco,
                observacoes: observacoes
            });
            
            document.getElementById(`select-produto-${mesaId}-${pessoaId}`).value = '';
            document.getElementById(`input-qtd-${mesaId}-${pessoaId}`).value = '1';
            document.getElementById(`input-obs-${mesaId}-${pessoaId}`).value = '';
            
            atualizarModalDetalheMesa();
        }

        function cancelarFormPedido(mesaId, pessoaId) {
            const form = document.getElementById(`form-pedido-${mesaId}-${pessoaId}`);
            form.classList.add('hidden');
            
            document.getElementById(`select-produto-${mesaId}-${pessoaId}`).value = '';
            document.getElementById(`input-qtd-${mesaId}-${pessoaId}`).value = '1';
            document.getElementById(`input-obs-${mesaId}-${pessoaId}`).value = '';
        }

        function mostrarFormPagamento(mesaId, pessoaId) {
            const form = document.getElementById(`form-pagamento-${mesaId}-${pessoaId}`);
            form.classList.toggle('hidden');
        }

        function confirmarPagamento(mesaId, pessoaId) {
            const mesa = salaoData.mesas.find(m => m.id === mesaId);
            if (!mesa) return;

            const pessoa = mesa.pessoas.find(p => p.id === pessoaId);
            if (!pessoa) return;

            const forma = document.getElementById(`select-forma-${mesaId}-${pessoaId}`).value;
            const valor = parseFloat(document.getElementById(`input-valor-${mesaId}-${pessoaId}`).value);
            
            if (!forma || valor <= 0) return;
            
            pessoa.pagamentos.push({
                forma: forma,
                valor: valor,
                horario: new Date().toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' })
            });
            
            atualizarModalDetalheMesa();
        }

        function cancelarFormPagamento(mesaId, pessoaId) {
            const form = document.getElementById(`form-pagamento-${mesaId}-${pessoaId}`);
            form.classList.add('hidden');
        }

        function adicionarPessoa(mesaId) {
            // Função mantida para compatibilidade, mas agora usa o formulário inline
            mostrarFormAdicionarPessoa(mesaId);
        }

        function adicionarPedidoPessoa(mesaId, pessoaId) {
            // Função mantida para compatibilidade, mas agora usa o formulário inline
            mostrarFormPedido(mesaId, pessoaId);
        }

        function registrarPagamento(mesaId, pessoaId) {
            // Função mantida para compatibilidade, mas agora usa o formulário inline
            mostrarFormPagamento(mesaId, pessoaId);
        }

        function transferirAtendente(mesaId) {
            // Função mantida para compatibilidade, mas agora usa o formulário inline
            mostrarTransferenciaAtendente(mesaId);
        }

        function toggleGorjeta(mesaId, pessoaId) {
            const mesa = salaoData.mesas.find(m => m.id === mesaId);
            if (!mesa) return;

            const pessoa = mesa.pessoas.find(p => p.id === pessoaId);
            if (!pessoa) return;

            pessoa.gorjetaHabilitada = !pessoa.gorjetaHabilitada;
            
            // Quando desabilitar gorjeta, resetar o percentual para 10%
            if (!pessoa.gorjetaHabilitada) {
                pessoa.gorjetaPercentual = 10;
            }
            
            atualizarModalDetalheMesa();
        }

        function editarGorjeta(mesaId, pessoaId) {
            const mesa = salaoData.mesas.find(m => m.id === mesaId);
            if (!mesa) return;

            const pessoa = mesa.pessoas.find(p => p.id === pessoaId);
            if (!pessoa) return;

            // Definir valores padrão
            if (!pessoa.gorjetaTipo) pessoa.gorjetaTipo = 'percentual';
            const percentualAtual = pessoa.gorjetaPercentual || 10;
            const valorFixoAtual = pessoa.gorjetaValorFixo || 0;
            
            // Criar modal personalizado inline
            const formId = `form-editar-gorjeta-${mesaId}-${pessoaId}`;
            const formExistente = document.getElementById(formId);
            
            if (formExistente) {
                formExistente.remove();
            }
            
            const formHTML = `
                <div id="${formId}" class="mt-2 p-2 bg-blue-50 rounded-lg space-y-2 border border-blue-200">
                    <div class="text-xs font-medium text-blue-900 mb-1">Editar Gorjeta de ${pessoa.nome}</div>
                    
                    <!-- Alternância de tipo -->
                    <div class="flex bg-white rounded-lg p-1 border border-blue-200">
                        <button onclick="alternarTipoGorjeta(${mesaId}, ${pessoaId}, 'percentual')" id="btn-tipo-percentual-${mesaId}-${pessoaId}" class="flex-1 px-2 py-1.5 text-xs rounded ${pessoa.gorjetaTipo === 'percentual' ? 'bg-blue-500 text-white' : 'text-gray-600'}">
                            Percentual (%)
                        </button>
                        <button onclick="alternarTipoGorjeta(${mesaId}, ${pessoaId}, 'fixo')" id="btn-tipo-fixo-${mesaId}-${pessoaId}" class="flex-1 px-2 py-1.5 text-xs rounded ${pessoa.gorjetaTipo === 'fixo' ? 'bg-blue-500 text-white' : 'text-gray-600'}">
                            Valor Fixo (R$)
                        </button>
                    </div>
                    
                    <!-- Campo de entrada (percentual) -->
                    <div id="campo-percentual-${mesaId}-${pessoaId}" class="${pessoa.gorjetaTipo === 'percentual' ? '' : 'hidden'} flex items-center space-x-2">
                        <input type="number" id="input-percentual-${mesaId}-${pessoaId}" value="${percentualAtual}" min="0" max="100" step="0.5" class="flex-1 px-2 py-1.5 text-xs border border-blue-300 rounded focus:ring-1 focus:ring-blue-500" placeholder="% gorjeta">
                        <span class="text-xs text-gray-600">%</span>
                    </div>
                    
                    <!-- Campo de entrada (valor fixo) -->
                    <div id="campo-fixo-${mesaId}-${pessoaId}" class="${pessoa.gorjetaTipo === 'fixo' ? '' : 'hidden'} flex items-center space-x-2">
                        <span class="text-xs text-gray-600">R$</span>
                        <input type="number" id="input-fixo-${mesaId}-${pessoaId}" value="${valorFixoAtual.toFixed(2)}" min="0" step="0.01" class="flex-1 px-2 py-1.5 text-xs border border-blue-300 rounded focus:ring-1 focus:ring-blue-500" placeholder="Valor da gorjeta">
                    </div>
                    
                    <div class="flex space-x-2">
                        <button onclick="confirmarEdicaoGorjeta(${mesaId}, ${pessoaId})" class="flex-1 px-2 py-1.5 bg-blue-500 text-white text-xs rounded hover:bg-blue-600">
                            Salvar
                        </button>
                        <button onclick="cancelarEdicaoGorjeta(${mesaId}, ${pessoaId})" class="flex-1 px-2 py-1.5 bg-gray-200 text-gray-600 text-xs rounded hover:bg-gray-300">
                            Cancelar
                        </button>
                    </div>
                </div>
            `;
            
            // Inserir o formulário após o resumo da pessoa
            const resumoElement = document.querySelector(`#form-pagamento-${mesaId}-${pessoaId}`);
            if (resumoElement && resumoElement.parentElement) {
                resumoElement.parentElement.insertAdjacentHTML('beforeend', formHTML);
                
                // Focar no input apropriado
                setTimeout(() => {
                    if (pessoa.gorjetaTipo === 'percentual') {
                        const input = document.getElementById(`input-percentual-${mesaId}-${pessoaId}`);
                        if (input) input.select();
                    } else {
                        const input = document.getElementById(`input-fixo-${mesaId}-${pessoaId}`);
                        if (input) input.select();
                    }
                }, 100);
            }
        }

        function alternarTipoGorjeta(mesaId, pessoaId, tipo) {
            const mesa = salaoData.mesas.find(m => m.id === mesaId);
            if (!mesa) return;

            const pessoa = mesa.pessoas.find(p => p.id === pessoaId);
            if (!pessoa) return;

            pessoa.gorjetaTipo = tipo;

            // Atualizar botões
            const btnPercentual = document.getElementById(`btn-tipo-percentual-${mesaId}-${pessoaId}`);
            const btnFixo = document.getElementById(`btn-tipo-fixo-${mesaId}-${pessoaId}`);
            const campoPercentual = document.getElementById(`campo-percentual-${mesaId}-${pessoaId}`);
            const campoFixo = document.getElementById(`campo-fixo-${mesaId}-${pessoaId}`);

            if (tipo === 'percentual') {
                btnPercentual.className = 'flex-1 px-2 py-1.5 text-xs rounded bg-blue-500 text-white';
                btnFixo.className = 'flex-1 px-2 py-1.5 text-xs rounded text-gray-600';
                campoPercentual.classList.remove('hidden');
                campoFixo.classList.add('hidden');
                
                // Focar no input
                const input = document.getElementById(`input-percentual-${mesaId}-${pessoaId}`);
                if (input) input.select();
            } else {
                btnPercentual.className = 'flex-1 px-2 py-1.5 text-xs rounded text-gray-600';
                btnFixo.className = 'flex-1 px-2 py-1.5 text-xs rounded bg-blue-500 text-white';
                campoPercentual.classList.add('hidden');
                campoFixo.classList.remove('hidden');
                
                // Focar no input
                const input = document.getElementById(`input-fixo-${mesaId}-${pessoaId}`);
                if (input) input.select();
            }
        }

        function confirmarEdicaoGorjeta(mesaId, pessoaId) {
            const mesa = salaoData.mesas.find(m => m.id === mesaId);
            if (!mesa) return;

            const pessoa = mesa.pessoas.find(p => p.id === pessoaId);
            if (!pessoa) return;
            
            if (pessoa.gorjetaTipo === 'percentual') {
                const input = document.getElementById(`input-percentual-${mesaId}-${pessoaId}`);
                if (!input) return;
                
                const percentual = parseFloat(input.value);
                
                if (isNaN(percentual) || percentual < 0 || percentual > 100) {
                    alert('Por favor, digite um percentual válido entre 0 e 100.');
                    return;
                }
                
                pessoa.gorjetaPercentual = percentual;
            } else if (pessoa.gorjetaTipo === 'fixo') {
                const input = document.getElementById(`input-fixo-${mesaId}-${pessoaId}`);
                if (!input) return;
                
                const valorFixo = parseFloat(input.value);
                
                if (isNaN(valorFixo) || valorFixo < 0) {
                    alert('Por favor, digite um valor válido maior ou igual a 0.');
                    return;
                }
                
                pessoa.gorjetaValorFixo = valorFixo;
            }
            
            atualizarModalDetalheMesa();
        }

        function cancelarEdicaoGorjeta(mesaId, pessoaId) {
            const formId = `form-editar-gorjeta-${mesaId}-${pessoaId}`;
            const form = document.getElementById(formId);
            if (form) {
                form.remove();
            }
        }

        function finalizarMesa(mesaId) {
            const mesa = salaoData.mesas.find(m => m.id === mesaId);
            if (!mesa) return;

            if (!todosJaPagaram(mesa)) {
                alert('Ainda há contas pendentes. Registre todos os pagamentos antes de finalizar a mesa.');
                return;
            }

            if (!confirm(`Finalizar Mesa ${mesa.numero}?\n\nTodos os pagamentos foram realizados. A mesa será liberada.`)) {
                return;
            }

            mesa.status = 'livre';
            mesa.cliente = null;
            mesa.atendente = null;
            mesa.horario = null;
            mesa.pessoas = [];
            mesa.pedidos = [];

            fecharModalDetalheMesa();
            renderizarMesas();
        }

        function liberarMesaReservada(mesaId) {
            const mesa = salaoData.mesas.find(m => m.id === mesaId);
            if (!mesa) return;

            mesa.status = 'livre';
            mesa.cliente = null;
            mesa.horario = null;

            renderizarMesas();
            alert(`Mesa ${mesa.numero} liberada com sucesso!`);
        }

        function atualizarAba(tabName) {
            if (tabName === 'pedidos') {
                renderizarPedidos(pedidosData.aguardando, 'coluna-aguardando', 'aguardando');
                renderizarPedidos(pedidosData.prontos, 'coluna-prontos', 'prontos');
                renderizarPedidos(pedidosData.aguardando, 'coluna-aguardando-mobile', 'aguardando');
                renderizarPedidos(pedidosData.prontos, 'coluna-prontos-mobile', 'prontos');
                
            } else if (tabName === 'salao') {
                renderizarMesas();
                
            } else if (tabName === 'kds') {
                renderizarPedidos(pedidosData.novos, 'coluna-novos', 'novos');
                renderizarPedidos(pedidosData.preparo, 'coluna-preparo', 'preparo');
                renderizarPedidos(pedidosData.novos, 'coluna-novos-mobile', 'novos');
                renderizarPedidos(pedidosData.preparo, 'coluna-preparo-mobile', 'preparo');
                
            } else if (tabName === 'entregas') {
                renderizarPedidos(pedidosData.pendentes, 'coluna-pendentes', 'pendentes');
                renderizarPedidos(pedidosData.rota, 'coluna-rota', 'rota');
                renderizarPedidos(pedidosData.pendentes, 'coluna-pendentes-mobile', 'pendentes');
                renderizarPedidos(pedidosData.rota, 'coluna-rota-mobile', 'rota');
            } else if (tabName === 'cardapio') {
                renderizarCardapio();
            } else if (tabName === 'configuracoes') {
                // Inicializar com a aba Perfil por padrão
                switchConfigSection('perfil');
            }
            atualizarContadores();
            
            // Inicializar botões deslizantes após renderizar
            setTimeout(() => {
                initSlideButtons();
            }, 100);
        }

        function aceitarPedido(id) {
            const pedidoIndex = pedidosData.aguardando.findIndex(p => p.id === id);
            if (pedidoIndex !== -1) {
                const pedido = pedidosData.aguardando.splice(pedidoIndex, 1)[0];
                pedidosData.novos.push(pedido);
                atualizarContadores();
                atualizarAba('pedidos');
                atualizarAba('kds');
            }
        }

        function prepararPedido(id) {
            const pedidoIndex = pedidosData.novos.findIndex(p => p.id === id);
            if (pedidoIndex !== -1) {
                const pedido = pedidosData.novos.splice(pedidoIndex, 1)[0];
                pedido.tempo = '15min';
                pedidosData.preparo.push(pedido);
                atualizarContadores();
                atualizarAba('kds');
            }
        }

        function finalizarPedido(id) {
            const pedidoIndex = pedidosData.preparo.findIndex(p => p.id === id);
            if (pedidoIndex !== -1) {
                const pedido = pedidosData.preparo.splice(pedidoIndex, 1)[0];
                pedido.tempo = '2min';
                pedidosData.prontos.push(pedido);
                atualizarContadores();
                atualizarAba('kds');
                atualizarAba('pedidos');
            }
        }

        function despacharPedido(id) {
            const pedidoIndex = pedidosData.prontos.findIndex(p => p.id === id);
            if (pedidoIndex !== -1) {
                const pedido = pedidosData.prontos.splice(pedidoIndex, 1)[0];
                pedido.entregador = 'Carlos Moto';
                pedido.tempoDesignacao = new Date().toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
                pedido.status = 'pendente';
                pedidosData.pendentes.push(pedido);
                atualizarContadores();
                atualizarAba('pedidos');
                atualizarAba('entregas');
            }
        }

        function coletarPedido(id) {
            const pedidoIndex = pedidosData.pendentes.findIndex(p => p.id === id);
            if (pedidoIndex !== -1) {
                const pedido = pedidosData.pendentes.splice(pedidoIndex, 1)[0];
                pedido.tempoSaida = new Date().toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
                const agora = new Date();
                agora.setMinutes(agora.getMinutes() + 30);
                pedido.previsaoEntrega = agora.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
                pedido.status = 'saindo';
                pedidosData.rota.push(pedido);
                atualizarContadores();
                atualizarAba('entregas');
            }
        }

        function confirmarEntrega(id) {
            const pedidoIndex = pedidosData.rota.findIndex(p => p.id === id);
            if (pedidoIndex !== -1) {
                pedidosData.rota.splice(pedidoIndex, 1);
                alert('Entrega confirmada com sucesso!');
                atualizarContadores();
                atualizarAba('entregas');
            }
        }

        function initSlideButtons() {
            document.querySelectorAll('.slide-button').forEach(button => {
                let isDragging = false;
                let startX = 0;
                let maxSlide = 0;
                
                const handle = button.querySelector('.slide-handle');
                
                function updateMaxSlide() {
                    maxSlide = button.offsetWidth - handle.offsetWidth - 4;
                }
                
                function handleStart(e) {
                    if (button.classList.contains('completed')) return;
                    
                    isDragging = true;
                    updateMaxSlide();
                    
                    const clientX = e.type === 'mousedown' ? e.clientX : e.touches[0].clientX;
                    startX = clientX;
                    
                    e.preventDefault();
                }
                
                function handleMove(e) {
                    if (!isDragging) return;
                    
                    const clientX = e.type === 'mousemove' ? e.clientX : e.touches[0].clientX;
                    const currentX = clientX - startX;
                    
                    let newTransform = Math.max(0, Math.min(maxSlide, currentX));
                    handle.style.transform = `translateX(${newTransform}px)`;
                    
                    const progress = newTransform / maxSlide;
                    const text = button.querySelector('.slide-text');
                    text.style.opacity = 1 - progress;
                    
                    e.preventDefault();
                }
                
                function handleEnd(e) {
                    if (!isDragging) return;
                    
                    isDragging = false;
                    
                    const transform = handle.style.transform;
                    const currentTransform = transform ? parseInt(transform.replace('translateX(', '').replace('px)', '')) : 0;
                    const progress = currentTransform / maxSlide;
                    
                    if (progress > 0.7) {
                        button.classList.add('completed');
                        handle.style.transform = `translateX(${maxSlide}px)`;
                        
                        setTimeout(() => {
                            executeSlideAction(button);
                        }, 300);
                    } else {
                        handle.style.transform = 'translateX(0px)';
                        const text = button.querySelector('.slide-text');
                        text.style.opacity = 1;
                    }
                }
                
                handle.addEventListener('mousedown', handleStart);
                document.addEventListener('mousemove', handleMove);
                document.addEventListener('mouseup', handleEnd);
                
                handle.addEventListener('touchstart', handleStart, { passive: false });
                document.addEventListener('touchmove', handleMove, { passive: false });
                document.addEventListener('touchend', handleEnd);
                
                window.addEventListener('resize', updateMaxSlide);
            });
        }
        
        function executeSlideAction(button) {
            const action = button.dataset.action;
            const pedidoId = button.dataset.pedidoId;
            
            switch(action) {
                case 'aceitarPedido':
                    aceitarPedido(pedidoId);
                    break;
                case 'prepararPedido':
                    prepararPedido(pedidoId);
                    break;
                case 'finalizarPedido':
                    finalizarPedido(pedidoId);
                    break;
                case 'despacharPedido':
                    despacharPedido(pedidoId);
                    break;
                case 'coletarPedido':
                    coletarPedido(pedidoId);
                    break;
                case 'confirmarEntrega':
                    confirmarEntrega(pedidoId);
                    break;
            }
        }

        // Inicialização
        document.addEventListener('DOMContentLoaded', function() {
            atualizarAba('pedidos');
            detectarModaisAbertos();
        });
    </script>
