        function salvarDiaFolga() {
            const data = document.getElementById('data-folga').value;
            const titulo = document.getElementById('titulo-folga').value.trim();
            const descricao = document.getElementById('descricao-folga').value.trim();
            
            if (!data) {
                alert('Selecione uma data para o dia de folga.');
                return;
            }
            
            const isEdicao = window.modalDiaFolgaAberto?.diaId !== null;
            
            if (isEdicao) {
                const diaId = window.modalDiaFolgaAberto.diaId;
                const diaIndex = sistemaDados.diasFolga.findIndex(d => d.id === diaId);
                
                if (diaIndex !== -1) {
                    sistemaDados.diasFolga[diaIndex] = {
                        ...sistemaDados.diasFolga[diaIndex],
                        data,
                        titulo,
                        descricao
                    };
                }
            } else {
                const novoId = Math.max(...(sistemaDados.diasFolga.map(d => d.id) || [0]), 0) + 1;
                
                sistemaDados.diasFolga.push({
                    id: novoId,
                    data,
                    titulo,
                    descricao
                });
            }
            
            renderizarListaDiasFolga();
            fecharModalDiaFolga();
        }

